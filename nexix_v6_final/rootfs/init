#!/bin/sh

# Mount virtual filesystems
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

# Clear screen and show retro boot log
clear
echo ""
echo "NEXIX OS v6.0 [Retro Core]"
echo "Copyright (c) 2015-2024 Nexix Foundation"
echo ""
echo "Booting system..."
echo "[ OK ] Mounted root filesystem"
echo "[ OK ] Started udev"
echo "[ OK ] Initialized hardware"
echo "[ OK ] Loaded kernel modules"
echo "[ OK ] Configured network loopback"
echo "[ OK ] Started system logger"
echo ""
echo "Welcome to Nexix OS v6.0"
echo "Type 'help' for available commands"
echo ""

# Start shell
exec /bin/sh
